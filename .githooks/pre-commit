#!/usr/bin/env bash
# Static guardrail: script syntax, Script API types, and the unit/contract tests.
# Enabled by `./test-addon.sh Setup` (git config core.hooksPath .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Temporary instrumentation is tagged TEMP-DIAGNOSTIC (docs/agents/bedrock-physics.md "Measuring"); none may be committed.
if git grep --cached -nI 'TEMP-DIAGNOSTIC' -- . ':!docs' ':!.githooks'; then
  echo "pre-commit: remove the TEMP-DIAGNOSTIC instrumentation above before committing" >&2
  exit 1
fi

git ls-files -z 'behavior_packs/*.js' 'testing/scenarios/*.js' 'testing/harness/*.js' | xargs -0 -n1 node --check
# A git worktree has no node_modules or venv of its own; it uses the main checkout's.
main=$(cd "$(git rev-parse --git-common-dir)/.." && pwd)
tsc=node_modules/.bin/tsc
[[ -x "$tsc" ]] || tsc=$main/node_modules/.bin/tsc
venv=.venv-testing
[[ -d "$venv" ]] || venv=$main/.venv-testing
"$tsc" -p jsconfig.json
python=$venv/bin/python
[[ -x "$python" ]] || python=$venv/Scripts/python.exe  # Windows venv layout
REQUIRE_NODE=1 "$python" -m pytest -q
