{
  "format_version": "1.8.0",
  "animations": {
    "animation.blake.monster_truck.engine_idle": {
      "loop": true,
      "animation_length": 1.0,
      "sound_effects": {
        "0.0": { "effect": "engine_idle" }
      }
    },
    "animation.blake.monster_truck.wheel_spin": {
      "loop": true,
      "animation_length": 1.0,
      "sound_effects": {
        "0.0": { "effect": "engine_drive" }
      },
      "bones": {
        "wheel_fl": {
          "rotation": {
            "0.0": [0, 0, 0],
            "1.0": [360, 0, 0]
          }
        },
        "wheel_fr": {
          "rotation": {
            "0.0": [0, 0, 0],
            "1.0": [360, 0, 0]
          }
        },
        "wheel_rl": {
          "rotation": {
            "0.0": [0, 0, 0],
            "1.0": [360, 0, 0]
          }
        },
        "wheel_rr": {
          "rotation": {
            "0.0": [0, 0, 0],
            "1.0": [360, 0, 0]
          }
        }
      }
    },
    "animation.blake.monster_truck.body_bob": {
      "loop": true,
      "animation_length": 0.5,
      "bones": {
        "body": {
          "position": {
            "0.0": [0, 0, 0],
            "0.25": [0, 0.35, 0],
            "0.5": [0, 0, 0]
          },
          "rotation": {
            "0.0": [0, 0, -0.6],
            "0.25": [0, 0, 0.6],
            "0.5": [0, 0, -0.6]
          }
        }
      }
    },
    "animation.blake.monster_truck.pitch": {
      "loop": true,
      "bones": {
        "root": {
          "rotation": [ "-query.property('blake:pitch_angle')", 0, 0 ]
        }
      }
    },
    "animation.blake.monster_truck.steer": {
      "loop": true,
      "bones": {
        "steer_fl": {
          "rotation": [ 0, "query.property('blake:steer_angle')", 0 ]
        },
        "steer_fr": {
          "rotation": [ 0, "query.property('blake:steer_angle')", 0 ]
        },
        "steer_rl": {
          "rotation": [ 0, "-query.property('blake:steer_angle') * 0.6923", 0 ]
        },
        "steer_rr": {
          "rotation": [ 0, "-query.property('blake:steer_angle') * 0.6923", 0 ]
        }
      }
    }
  }
}
